# 项目猫 - ESP32-S3-EYE 摄像头配置
# SDK 配置文件

# ==================== 摄像头配置 ====================
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# 摄像头驱动支持
CONFIG_ESP_CAMERA_SUPPORT=y
CONFIG_ESP_CAMERA_SENSOR_OV2640=y
CONFIG_CAMERA_TASK_STACK_SIZE=4096
CONFIG_CAMERA_XCLK_FREQ_MHZ=20

# ==================== WiFi 配置 ====================
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_SLP_IRON_OPT=y

# ==================== HTTP 配置 ====================
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y

# ==================== NVS 配置 ====================
CONFIG_NVS_FLASH_COMPRESSION=y

# ==================== LwIP 配置 ====================
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_NETBUF_RECVINFO=y

# ==================== SNTP 配置 ====================
CONFIG_SNTP_MAX_SERVERS=1
CONFIG_SNTP_SERVER_DEFAULT_ADDRESS="pool.ntp.org"
CONFIG_SNTP_UPDATE_METHOD_SMOOTH=y

# ==================== 日志配置 ====================
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ==================== 分区表配置 ====================
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ==================== 电源管理 ====================
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000

# ==================== SPI 配置 ====================
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y